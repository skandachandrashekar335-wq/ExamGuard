# ExamGuard Backend Environment Variables
# Copy this to .env and fill in values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/examguard

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-to-a-random-secret-key

# CORS - add your frontend URL(s)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Firebase - REQUIRED for authentication
FIREBASE_PROJECT_ID=ggvoting-8ac37
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_AUTH_DOMAIN=ggvoting-8ac37.firebaseapp.com

# Initial admin provisioning - first user with this email gets ADMIN role
# Only used when NO admin exists in the database yet
INITIAL_ADMIN_EMAILS=["powrskanda@gmail.com"]

# Tesseract (for OCR)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler (for PDF processing)
POPPLER_PATH=C:\Tools\poppler\poppler-26.02.0\Library\bin
