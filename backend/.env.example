# ExamGuard Backend Environment Variables
# Copy this to .env and fill in values. Never commit real values.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/examguard

# Security — set a unique random value per environment
SECRET_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Firebase — required for authentication
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# Initial admin provisioning (JSON array of emails). Only applied when no admin exists.
INITIAL_ADMIN_EMAILS=[]

# Face verification
FACE_VERIFICATION_PROVIDER=deterministic

# Cloudinary (optional; required in demo deployment for reference faces)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tesseract (OCR)
TESSERACT_CMD=

# Poppler (PDF processing)
POPPLER_PATH=
