# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/examguard

# Application
APP_NAME=ExamGuard
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# Backend API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
