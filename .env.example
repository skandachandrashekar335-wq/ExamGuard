# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/examguard

# Application
APP_NAME=ExamGuard
APP_ENV=development
DEBUG=true
SECRET_KEY=

# Backend API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Face verification
FACE_VERIFICATION_PROVIDER=deterministic
IDENTITY_VERIFICATION_MATCH_THRESHOLD=0.85

# Firebase (required for auth token exchange)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# Cloudinary (reference-face storage when enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
